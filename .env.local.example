# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase
# (Project Settings → API). NUNCA commitees .env.local — ya debería estar en .gitignore.

# Públicas: van al navegador, seguro exponerlas — su seguridad depende de RLS, no de que
# estén "escondidas". Deben llevar el prefijo NEXT_PUBLIC_ para que Next.js las incluya
# en el bundle del cliente.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# PRIVADA: jamás debe llevar el prefijo NEXT_PUBLIC_ ni usarse en un componente cliente.
# Se salta por completo Row Level Security. Solo para lib/supabase/admin.ts, en los
# casos descritos ahí (webhooks, cron jobs server-side). Si este proyecto nunca necesita
# esos casos, no la configures.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
